<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="payment_method_is_active">
        <observer name="payplug_restrict_payment_method_by_country"
                  instance="Payplug\Payments\Observer\HidePaymentMethodForRestrictedCountries"/>
    </event>
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="payplug_payments_restore_quote_on_checkout_return"
                  instance="Payplug\Payments\Observer\RestoreQuoteOnCheckoutReturn"/>
    </event>
</config>
